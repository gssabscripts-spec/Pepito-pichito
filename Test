local Flying = false
local FlySpeed = 50
local FlyConnection

local function StartFly()
    if not Character or not RootPart or not Humanoid then return end
    
    Humanoid.PlatformStand = true

    local BodyVel = Instance.new("BodyVelocity")
    BodyVel.Name = "FluentFlyVel"
    BodyVel.Parent = RootPart
    BodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    BodyVel.Velocity = Vector3.new(0, 0, 0)

    local BodyGyro = Instance.new("BodyGyro")
    BodyGyro.Name = "FluentFlyGyro"
    BodyGyro.Parent = RootPart
    BodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    BodyGyro.CFrame = RootPart.CFrame

    FlyConnection = RunService.RenderStepped:Connect(function()
        if not Flying or not Character or not RootPart.Parent then
            if BodyVel then BodyVel:Destroy() end
            if BodyGyro then BodyGyro:Destroy() end
            if Humanoid then Humanoid.PlatformStand = false end
            if FlyConnection then FlyConnection:Disconnect() end
            return
        end

        BodyGyro.CFrame = Camera.CFrame
        
        local moveDir = Humanoid.MoveDirection
        local velocity = Vector3.new(0, 0, 0)
        
        if moveDir.Magnitude > 0 then
            local camSpace = Camera.CFrame:VectorToObjectSpace(moveDir)
            velocity = (Camera.CFrame.LookVector * -camSpace.Z) + (Camera.CFrame.RightVector * camSpace.X)
        end
        
        BodyVel.Velocity = velocity * FlySpeed
    end)
end

local FlyToggle = Tabs.Movement:AddToggle("FlyToggle", {
    Title = "Enable Flight",
    Default = false
})

FlyToggle:OnChanged(function()
    Flying = FlyToggle.Value
    if Flying then
        StartFly()
    else
        if RootPart then
            if RootPart:FindFirstChild("FluentFlyVel") then RootPart.FluentFlyVel:Destroy() end
            if RootPart:FindFirstChild("FluentFlyGyro") then RootPart.FluentFlyGyro:Destroy() end
        end
        if Humanoid then
            Humanoid.PlatformStand = false
        end
        if FlyConnection then
            FlyConnection:Disconnect()
        end
    end
end)

Tabs.Movement:AddInput("FlySpeedInput", {
    Title = "Flight Speed",
    Description = "",
    Default = "50",
    Placeholder = "Type fly speed...",
    Numeric = true,
    Finished = true,
    Callback = function(Value)
        local num = tonumber(Value)
        if num then
            FlySpeed = num
        end
    end
})


--- ==================== MISC TAB ==================== ---

local NoclipEnabled = false
local NoclipConnection

local NoclipToggle = Tabs.Misc:AddToggle("NoclipToggle", {
    Title = "Noclip (Walk Through Walls)",
    Default = false
})

NoclipToggle:OnChanged(function()
    NoclipEnabled = NoclipToggle.Value
    
    if NoclipEnabled then
        NoclipConnection = RunService.Stepped:Connect(function()
            if NoclipEnabled and Character then
                for _, part in ipairs(Character:GetDescendants()) do
                    if part:IsA("BasePart") and part.CanCollide then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end
        if Character then
            for _, part in ipairs(Character:GetDescendants()) do
                if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                    part.CanCollide = true
                end
            end
        end
    end
end)

