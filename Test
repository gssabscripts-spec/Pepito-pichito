--- ==================== DRAGGABLE REOPEN BUTTON ON THE LEFT ==================== ---
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "GSSAB_ReopenGui"
ScreenGui.ResetOnSpawn = false
pcall(function() ScreenGui.Parent = CoreGui end)
if not ScreenGui.Parent then ScreenGui.Parent = Player.PlayerGui end

local ToggleButton = Instance.new("TextButton")
ToggleButton.Name = "ReopenButton"
ToggleButton.Parent = ScreenGui
ToggleButton.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
ToggleButton.BorderColor3 = Color3.fromRGB(60, 60, 60)
ToggleButton.Position = UDim2.new(0.02, 0, 0.25, 0) -- Positioned on the left side
ToggleButton.Size = UDim2.new(0, 110, 0, 40)
ToggleButton.Font = Enum.Font.GothamBold
ToggleButton.Text = "Open UI"
ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleButton.TextSize = 14
ToggleButton.Visible = false -- Hidden by default while menu is open

local UICorner = Instance.new("UICorner")
UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = ToggleButton

-- Make the reopen button draggable
local dragging, dragStart, startPos
ToggleButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = ToggleButton.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        ToggleButton.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

local isMinimized = false
local function SetUIVisible(state)
    isMinimized = not state
    if Window.Root then
        Window.Root.Visible = state
    end
    ToggleButton.Visible = not state
end

ToggleButton.MouseButton1Click:Connect(function()
    SetUIVisible(true)
end)

-- Auto-detects when you click the [-] minimize button on the window top-right
task.spawn(function()
    while true do
        task.wait(0.2)
        if Window and Window.Root then
            if not Window.Root.Visible and not isMinimized then
                SetUIVisible(false)
            end
        end
    end
end)

